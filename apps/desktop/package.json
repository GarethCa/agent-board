{
  "name": "@agent-board/desktop",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "playwright test --project app --project perf",
    "test:visual": "playwright test --project visual",
    "readme:screenshots": "playwright test --project readme",
    "package": "rm -rf dist && electron-vite build && electron-builder --dir && node ../../scripts/app-install/main.ts",
    "test:e2e:packaged": "playwright test --project packaged"
  },
  "devDependencies": {
    "@agent-board/daemon": "workspace:*",
    "@agent-board/fake-harness": "workspace:*",
    "@agent-board/tracker": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@types/hast": "^3.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "8.5.29",
    "sharp": "0.35.5",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.2.10",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@fontsource/caveat": "5.2.8",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "^12.12.0",
    "hast-util-to-text": "^4.0.2",
    "highlight.js": "^11.11.2",
    "lowlight": "^3.3.0",
    "lucide-react": "1.48.0",
    "node-pty": "1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}

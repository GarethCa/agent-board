{
  "name": "agent-board",
  "private": true,
  "description": "An infinite board for your Claude Code and Codex sessions",
  "license": "FSL-1.1-ALv2",
  "homepage": "https://github.com/GarethCa/agent-board#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GarethCa/agent-board.git"
  },
  "bugs": {
    "url": "https://github.com/GarethCa/agent-board/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm -r test:e2e",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e && pnpm visual:check && pnpm package --no-install && pnpm test:e2e:packaged",
    "check:local": "sh scripts/check-local.sh",
    "check:pr": "node scripts/check-pr/main.ts",
    "knip": "knip --no-progress",
    "package": "pnpm --filter @agent-board/desktop package",
    "test:e2e:packaged": "pnpm --filter @agent-board/desktop test:e2e:packaged",
    "update:app": "sh scripts/update-app.sh",
    "visual:check": "sh scripts/visual.sh check",
    "visual:update": "sh scripts/visual.sh update",
    "readme:screenshots": "sh scripts/readme-screenshots.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "knip": "5.88.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
